
networks:
  vswarm-edge:
    name: vswarm-edge
{{- if .EdgeExternal}}
    external: true
{{- else}}
    driver: bridge
    ipam:
      config:
        - subnet: {{.EdgeSubnet}}
{{- end}}
{{- range .Tenants}}
  {{.Net}}:
    name: {{.Net}}
    driver: bridge
    ipam:
      config:
        - subnet: {{.Subnet}}
{{- end}}

services:
  vswarm-proxy:
    image: docker.angie.software/angie:latest
    container_name: vswarm-proxy
    restart: unless-stopped
    command: ["angie", "-g", "daemon off;"]
    volumes:
      - ./generated/angie/angie.conf:/etc/angie/angie.conf:ro
      - ./generated/angie/tenants:/etc/angie/tenants:ro
    networks:
      vswarm-edge:
        ipv4_address: {{.ProxyIP}}
{{- range .Tenants}}
      {{.Net}}: {}
{{- end}}
    security_opt:
      - no-new-privileges:true

{{- if .ManageTunnel}}
  vswarm-tunnel:
    image: cloudflare/cloudflared:latest
    container_name: vswarm-tunnel
    restart: unless-stopped
    command: ["tunnel", "--no-autoupdate", "run", "--token", "${VSWARM_TUNNEL_TOKEN}"]
    depends_on:
      - vswarm-proxy
    networks:
      - vswarm-edge
    security_opt:
      - no-new-privileges:true
{{- end}}
{{range .Tenants}}
  {{.Container}}:
    image: {{$.Image}}
    container_name: {{.Container}}
    restart: unless-stopped
    init: true
    hostname: {{$.Team}}
    networks:
      - {{.Net}}
    environment:
      - T3CODE_HOME=/home/ai-agent/.config/t3
      - VSWARM_USER={{.Name}}
{{- range $.CacheEnv}}
      - {{.K}}={{.V}}
{{- end}}
    volumes:
      - {{.WorkVolume}}:{{$.HomeDir}}
      - {{.CacheVolume}}:{{$.CacheDir}}
{{- range $.Mounts}}
      - {{.Source}}:{{.Target}}:ro
{{- end}}
    tmpfs:
      - {{$.RunDir}}
    ulimits:
      nofile: 4096
    pids_limit: {{$.Pids}}
    deploy:
      resources:
        limits:
          cpus: "{{$.CPUs}}"
          memory: {{$.Memory}}
          pids: {{$.Pids}}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3773/api/auth/session"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 40s
{{end}}
{{- range .Tenants}}{{if .Postgres}}
  {{.DBContainer}}:
    image: {{$.DBImage}}
    container_name: {{.DBContainer}}
    restart: unless-stopped
    networks:
      - {{.Net}}
    environment:
      - POSTGRES_PASSWORD={{.PGPassword}}
    volumes:
      - {{.DBVolume}}:/var/lib/postgresql
    tmpfs:
      - /run
    deploy:
      resources:
        limits:
          memory: {{$.DBMemory}}
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 30s
{{- end}}{{end}}
{{- range .Tenants}}{{if .Playwright}}
  {{.PWContainer}}:
    image: {{$.PlaywrightImage}}
    container_name: {{.PWContainer}}
    restart: unless-stopped
    init: true
    networks:
      - {{.Net}}
    command: ["--headless=new", "--no-sandbox", "--remote-debugging-address=0.0.0.0",
              "--remote-debugging-port={{$.PWPort}}", "--disable-gpu",
              "--disable-dev-shm-usage", "about:blank"]
    tmpfs:
      - /run
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 2g
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:{{$.PWPort}}/json/version >/dev/null"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 10s
{{- end}}{{end}}

volumes:
{{- range .Tenants}}
  {{.WorkVolume}}:
    name: {{.WorkVolume}}
    driver: {{$.Driver}}
{{- if $.DriverOpts}}
    driver_opts:
{{- range $.DriverOpts}}
      {{.K}}: "{{.V}}"
{{- end}}
{{- end}}
  {{.CacheVolume}}:
    name: {{.CacheVolume}}
    driver: local
{{- end}}
{{- range .Tenants}}{{if .Postgres}}
  {{.DBVolume}}:
    name: {{.DBVolume}}
    driver: {{$.Driver}}
{{- if $.DriverOpts}}
    driver_opts:
{{- range $.DriverOpts}}
      {{.K}}: "{{.V}}"
{{- end}}
{{- end}}
{{- end}}{{end}}
