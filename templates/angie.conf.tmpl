
{{if .AccessAUD}}load_module /usr/lib/angie/modules/ngx_http_auth_jwt_module.so;
{{end}}worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/angie.pid;

events {
    worker_connections 1024;
}

http {
    resolver 127.0.0.11 valid=10s ipv6=off;
{{- if .AccessAUD}}

    # Cloudflare's key set is about 5 KB -- two keys and their certificates --
    # and a subrequest's response is held in memory, capped at 4 KB by default.
    subrequest_output_buffer_size 64k;
    proxy_cache_path /tmp/vswarm-access-certs levels=1 keys_zone=vswarm_access_certs:1m
                     max_size=1m inactive=7d use_temp_path=off;
{{- end}}

{{range .Tenants}}
    upstream vswarm_{{.Name}} {
        zone vswarm_{{.Name}} 64k;
        server {{.Container}}:{{$.T3Port}} resolve;
        keepalive 16;
    }
{{end}}
    map {{.Identity}} $vswarm_upstream {
        default "";
        include /etc/angie/tenants/*.upstream;
    }

    map {{.Identity}} $vswarm_token {
        default "";
        include /etc/angie/tenants/*.token;
    }

    # A dev server in a workspace is reachable at <port>.<domain>. The identity
    # still chooses the container -- this map only carries the port -- so the
    # worst a wrong guess can do is miss a port in the requester's own
    # workspace. The upstream map above names an upstream block, which cannot
    # carry a port, so ports need the container's address instead.
    map {{.Identity}} $vswarm_container {
        default "";
        include /etc/angie/tenants/*.host;
    }

    map $http_upgrade $vswarm_connection {
        default upgrade;
        ''      "";
    }

    log_format vswarm '$remote_addr "{{.Identity}}" '
                      '-> $vswarm_upstream $status $body_bytes_sent';
    access_log /dev/stdout vswarm;

    server {
        listen 127.0.0.1:9145;
        location = /healthz { return 200 "ok\n"; }
    }

    # A dev server in a workspace answers at <port>-<label>.<zone> -- the domain
    # with a port prefixed to its first label, 5180-vs.example.com for
    # vs.example.com. That keeps it one level under the zone apex, where the
    # certificate that already covers *.<zone> reaches, and lets Access be scoped
    # to *-<label>.<zone> alone: a DNS wildcard must be a whole label, an Access
    # application may wildcard within one.
    #
    # Only the port travels in the hostname. The identity still chooses the
    # container, so the worst a wrong guess reaches is a port in the guesser's
    # own workspace. No Authorization header: the server behind this is the
    # tenant's own, not t3.
    server {
        listen {{.ProxyIP}}:{{.ProxyPort}};
        server_name ~{{.DevHostPattern}};
{{- if .AccessAUD}}
{{template "access_certs" .}}
{{- end}}

        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        tcp_nodelay on;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;

        location / {
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin      "$http_origin" always;
                add_header Access-Control-Allow-Methods     "$http_access_control_request_method" always;
                add_header Access-Control-Allow-Headers     "$http_access_control_request_headers" always;
                add_header Access-Control-Max-Age           600 always;
                add_header Content-Length                   0 always;
                return 204;
            }

{{- if .AccessAUD}}
{{template "access_gate" .}}
            auth_jwt_require $vswarm_container error=403;
{{- else}}

            if ($vswarm_container = "") {
                return 403 "vibeswarm: no workspace mapped for this identity\n";
            }
{{- end}}

            proxy_pass http://$vswarm_container:$devport$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host               $host;
            proxy_set_header Upgrade            $http_upgrade;
            proxy_set_header Connection         $vswarm_connection;
            proxy_set_header X-Forwarded-For    $remote_addr;
            proxy_set_header X-Forwarded-Proto  https;
        }
    }

    # Every hostname the tunnel delivers that nobody declared. The identity
    # header the maps above read is only trustworthy on a hostname Access
    # protects, and a wildcard DNS record delivers names it does not -- where a
    # client can send that header itself. So these are refused before any map is
    # consulted, rather than falling through to a workspace.
    server {
        listen {{.ProxyIP}}:{{.ProxyPort}} default_server;
        server_name _;
        return 404;
    }

    server {
        listen {{.ProxyIP}}:{{.ProxyPort}};
        server_name {{.Domain}};
{{- if .AccessAUD}}
{{template "access_certs" .}}
{{- end}}

        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        tcp_nodelay on;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;

        location / {
            # A CORS preflight carries no credentials, by specification -- no cookie,
            # no Access identity header -- so it can never map to an upstream and the
            # identity check below would reject every one of them. Any client that is
            # a browser engine sends one before a cross-origin request with an
            # Authorization header, which is what pairing a workspace as a remote
            # environment is, so rejecting them makes the workspace unreachable to
            # every such client. Answer it here instead.
            #
            # Answering permissively grants nothing: a preflight carries no data and
            # returns none, and the request it precedes still arrives without an
            # identity and is still rejected below. Echoing what the preflight asked
            # for, rather than restating a list, is also what keeps this from drifting
            # away from whatever the workspace behind it actually accepts.
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin      "$http_origin" always;
                add_header Access-Control-Allow-Methods     "$http_access_control_request_method" always;
                add_header Access-Control-Allow-Headers     "$http_access_control_request_headers" always;
                add_header Access-Control-Max-Age           600 always;
                add_header Content-Length                   0 always;
                return 204;
            }

{{- if .AccessAUD}}
{{template "access_gate" .}}
            auth_jwt_require $vswarm_upstream error=403;
{{- else}}

            if ($vswarm_upstream = "") {
                return 403 "vibeswarm: no workspace mapped for this identity\n";
            }
{{- end}}

            proxy_pass http://$vswarm_upstream$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host               $host;
            proxy_set_header Upgrade            $http_upgrade;
            proxy_set_header Connection         $vswarm_connection;
            proxy_set_header X-Forwarded-For    $remote_addr;
            proxy_set_header X-Forwarded-Proto  https;
            proxy_set_header Authorization      "Bearer $vswarm_token";
        }
    }
}

{{define "access_gate"}}
            # Identity comes from the Access JWT, verified here, and not from the
            # header Access sets beside it: a header is only as trustworthy as the
            # network in front of this proxy, a signature does not depend on it.
            # The claims only exist from this phase on, which is why the refusal
            # for an unmapped identity lives here and not in a rewrite-phase if.
            auth_jwt "vswarm" token=$http_cf_access_jwt_assertion;
            auth_jwt_key_request /.vswarm/access-certs jwks;
            auth_jwt_require_claim iss eq "https://{{.AccessTeamDomain}}";
            auth_jwt_require_claim aud intersect json=["{{.AccessAUD}}"];
{{- end}}

{{define "access_certs"}}
        # Access's signing keys, cached for an hour and served stale when Cloudflare
        # is unreachable. Buffering is back on because the servers turn it off and
        # nothing unbuffered is cached; client headers stay here.
        location = /.vswarm/access-certs {
            internal;
            set $vswarm_access_certs "https://{{.AccessTeamDomain}}/cdn-cgi/access/certs";
            proxy_pass $vswarm_access_certs;
            proxy_ssl_server_name on;
            proxy_ssl_name {{.AccessTeamDomain}};
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_pass_request_headers off;
            proxy_pass_request_body off;
            proxy_buffering on;
            proxy_cache vswarm_access_certs;
            proxy_cache_valid 200 1h;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_ignore_headers Cache-Control Expires Set-Cookie;
        }
{{- end}}
