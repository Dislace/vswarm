
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/angie.pid;

events {
    worker_connections 1024;
}

http {
    resolver 127.0.0.11 valid=10s ipv6=off;

{{range .Tenants}}
    upstream vswarm_{{.Name}} {
        zone vswarm_{{.Name}} 64k;
        server {{.Container}}:{{$.T3Port}} resolve;
        keepalive 16;
    }
{{end}}
    map $http_cf_access_authenticated_user_email $vswarm_upstream {
        default "";
        include /etc/angie/tenants/*.upstream;
    }

    map $http_cf_access_authenticated_user_email $vswarm_token {
        default "";
        include /etc/angie/tenants/*.token;
    }

    map $http_upgrade $vswarm_connection {
        default upgrade;
        ''      "";
    }

    log_format vswarm '$remote_addr "$http_cf_access_authenticated_user_email" '
                      '-> $vswarm_upstream $status $body_bytes_sent';
    access_log /dev/stdout vswarm;

    server {
        listen 127.0.0.1:9145;
        location = /healthz { return 200 "ok\n"; }
    }

    server {
        listen {{.ProxyIP}}:{{.ProxyPort}};
        server_name _;

        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        tcp_nodelay on;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;

        location / {
            # A CORS preflight carries no credentials, by specification -- no cookie,
            # no Access identity header -- so it can never map to an upstream and the
            # identity check below would reject every one of them. Any client that is
            # a browser engine sends one before a cross-origin request with an
            # Authorization header, which is what pairing a workspace as a remote
            # environment is, so rejecting them makes the workspace unreachable to
            # every such client. Answer it here instead.
            #
            # Answering permissively grants nothing: a preflight carries no data and
            # returns none, and the request it precedes still arrives without an
            # identity and is still rejected below. Echoing what the preflight asked
            # for, rather than restating a list, is also what keeps this from drifting
            # away from whatever the workspace behind it actually accepts.
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin      "$http_origin" always;
                add_header Access-Control-Allow-Methods     "$http_access_control_request_method" always;
                add_header Access-Control-Allow-Headers     "$http_access_control_request_headers" always;
                add_header Access-Control-Max-Age           600 always;
                add_header Content-Length                   0 always;
                return 204;
            }

            if ($vswarm_upstream = "") {
                return 403 "vibeswarm: no workspace mapped for this identity\n";
            }

            proxy_pass http://$vswarm_upstream$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host               $host;
            proxy_set_header Upgrade            $http_upgrade;
            proxy_set_header Connection         $vswarm_connection;
            proxy_set_header X-Forwarded-For    $remote_addr;
            proxy_set_header X-Forwarded-Proto  https;
            proxy_set_header Authorization      "Bearer $vswarm_token";
        }
    }
}
