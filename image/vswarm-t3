#!/usr/bin/env bash
set -euo pipefail

BAKED=/opt/t3-runtime
T3_HOME="${T3CODE_HOME:-${HOME}/.config/t3}"
VERSIONS="${T3_HOME}/runtime/versions"
STATE="${T3_HOME}/runtime/service-state.json"
CACHE_VERSIONS="${XDG_CACHE_HOME:-${HOME}/.cache}/vswarm/t3/versions"

usage() {
  cat <<'USAGE'
vswarm-t3 — the t3 runtime this workspace serves

USAGE
  vswarm-t3 status       the active version, the installed ones, and the launcher
  vswarm-t3 active       print the active version alone
  vswarm-t3 cli <args>   run the active t3 CLI
  vswarm-t3 bootstrap    seed the runtime from the image, drop superseded versions

A runtime is a t3 release payload -- the self-contained executable and the
files beside it -- under ~/.config/t3/runtime/versions/<version>. t3 updates
itself in place: the app installs the version you pick there and its service
launcher switches to it. The version baked into the image is only the floor a
fresh workspace starts from.
USAGE
}

version_of() {
  node -e 'process.stdout.write(require(process.argv[1]).version)' "$1/package.json" 2>/dev/null
}

baked_version() {
  version_of "${BAKED}"
}

# Where t3 itself looks for a runtime's executable, so this is the one shape a
# seeded runtime has to match.
entry_for() {
  printf '%s/%s/t3' "${VERSIONS}" "$1"
}

# An executable and a sentinel naming the same version is what t3 accepts, and
# matching it exactly is what keeps a runtime t3 installed for itself from being
# pruned as unusable. A runtime seeded from the image needs one check more: it
# is a symlink into the image, so an image whose floor moved leaves a directory
# whose name and sentinel still say the old version while the payload behind
# them is the new one.
installed() {
  local version=$1
  if [ -z "${version}" ]; then
    return 1
  fi
  if [ ! -x "$(entry_for "${version}")" ]; then
    return 1
  fi
  if [ "$(cat "${VERSIONS}/${version}/.install-complete" 2>/dev/null)" != "${version}" ]; then
    return 1
  fi
  if [ -L "$(entry_for "${version}")" ]; then
    [ "$(baked_version)" = "${version}" ] || return 1
  fi
  return 0
}

state_field() {
  node -e '
    const fs = require("node:fs")
    const [file, ...keys] = process.argv.slice(1)
    let value
    try {
      value = JSON.parse(fs.readFileSync(file, "utf8"))
    } catch {
      process.exit(0)
    }
    for (const key of keys) value = value?.[key]
    if (typeof value === "string") process.stdout.write(value)
  ' "${STATE}" "$@"
}

active_version() {
  state_field activeVersion
}

named_versions() {
  local keys
  for keys in "activeVersion" "update fromVersion" "update targetVersion"; do
    # shellcheck disable=SC2086
    state_field ${keys}
    printf '\n'
  done
}

write_state() {
  mkdir -p "$(dirname "${STATE}")"
  printf '{"protocol":2,"activeVersion":"%s"}\n' "$1" >"${STATE}"
}

# Runtimes are rebuildable, so they belong on the cache volume rather than the
# work volume a migration has to carry. Only the record of which one is active
# stays durable.
link_versions() {
  # Unconditionally, because the cache volume being disposable means the link
  # can outlive the directory it names: a workspace whose cache was dropped
  # while its work volume stayed would otherwise meet a dangling link here and
  # fail to start, rather than rebuilding what was never meant to be durable.
  mkdir -p "${CACHE_VERSIONS}"
  if [ -L "${VERSIONS}" ] || [ -d "${VERSIONS}" ]; then
    return 0
  fi
  mkdir -p "$(dirname "${VERSIONS}")"
  ln -s "${CACHE_VERSIONS}" "${VERSIONS}"
}

# Linking each entry of the payload rather than copying it keeps a workspace's
# first start off the ~150MB the executable alone weighs, and keeps the runtime
# the image bakes in one place on disk however many tenants share the image.
seed() {
  local version=$1 staging entry
  if installed "${version}"; then
    return 0
  fi
  mkdir -p "${VERSIONS}"
  rm -rf "${VERSIONS:?}/${version}"
  staging=$(mktemp -d "${VERSIONS}/.staging-XXXXXX")
  for entry in "${BAKED}"/*; do
    ln -s "${entry}" "${staging}/$(basename "${entry}")"
  done
  printf '%s\n' "${version}" >"${staging}/.install-complete"
  mv "${staging}" "${VERSIONS}/${version}"
}

prune() {
  local keep=" $* " dir name
  for dir in "${VERSIONS}"/*/; do
    if [ ! -d "${dir}" ]; then
      continue
    fi
    name=$(basename "${dir}")
    case "${keep}" in
      *" ${name} "*) continue ;;
    esac
    rm -rf "${dir}"
  done
}

cmd_bootstrap() {
  local baked active version
  local -a keep=()
  baked=$(baked_version)
  link_versions
  seed "${baked}"
  active=$(active_version)
  if ! installed "${active}"; then
    active="${baked}"
    write_state "${active}"
  fi
  while IFS= read -r version; do
    if [ -n "${version}" ]; then
      keep+=("${version}")
    fi
  done < <(named_versions)
  prune "${keep[@]}" "${active}" "${baked}"
}

cmd_active() {
  local active
  active=$(active_version)
  if ! installed "${active}"; then
    echo "no usable t3 runtime is installed" >&2
    return 1
  fi
  printf '%s\n' "${active}"
}

cmd_cli() {
  local active
  active=$(active_version)
  if installed "${active}"; then
    exec "$(entry_for "${active}")" "$@"
  fi
  exec "${BAKED}/t3" "$@"
}

cmd_status() {
  local active dir name
  active=$(active_version)
  printf 'active     %s\n' "${active:-none}"
  printf 'image      %s\n' "$(baked_version)"
  if pgrep -f '__service-launcher' >/dev/null 2>&1; then
    printf 'launcher   running\n'
  else
    printf 'launcher   not running\n'
  fi
  for dir in "${VERSIONS}"/*/; do
    if [ ! -d "${dir}" ]; then
      continue
    fi
    name=$(basename "${dir}")
    printf 'installed  %s\n' "${name}"
  done
}

case "${1:-status}" in
  status) cmd_status ;;
  active) cmd_active ;;
  bootstrap) cmd_bootstrap ;;
  cli)
    shift
    cmd_cli "$@"
    ;;
  -h | --help | help) usage ;;
  *)
    echo "unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
